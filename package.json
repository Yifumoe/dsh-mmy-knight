{
  "name": "dsh-mmy-knight",
  "version": "0.2.0",
  "description": "DSH 插件「小伊的守护骑士」：拦住模型复读打转（llm/stream + turn-stopping）、过程纪律提醒，并在调度器投递失败时自动重试。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "knight",
    "repeat-guard",
    "process-discipline",
    "progress-nudge",
    "schedule",
    "retry",
    "loop-detection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yifumoe/dsh-mmy-knight.git"
  },
  "homepage": "https://github.com/Yifumoe/dsh-mmy-knight#readme",
  "bugs": {
    "url": "https://github.com/Yifumoe/dsh-mmy-knight/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.2"
  }
}
